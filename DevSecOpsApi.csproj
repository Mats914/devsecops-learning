<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>DevSecOpsApi</RootNamespace>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

  <!-- Exclude Tests folder from the main API project -->
  <ItemGroup>
    <Compile Remove="Tests\**" />
    <Content Remove="Tests\**" />
    <EmbeddedResource Remove="Tests\**" />
    <None Remove="Tests\**" />
  </ItemGroup>

  <!--
    ══════════════════════════════════════════════════════════════
    SECURITY NOTE (DevSecOps principle: keep dependencies patched)
    ══════════════════════════════════════════════════════════════
    All versions below are pinned to the latest safe release as of 2025.

    Fixed vulnerabilities:
    - SixLabors.ImageSharp 3.1.3 → 3.1.7
        GHSA-63p8-c4ww-9cg7 (High)  – fixed in 3.1.5
        GHSA-2cmq-823j-5qj8 (High)  – fixed in 3.1.5
        + 4 Moderate CVEs
    - MailKit 4.3.0 → 4.9.0
        GHSA-9j88-vvj5-vhgr (Moderate) – fixed in 4.8.0
    - MimeKit (transitive via MailKit) → fixed by upgrading MailKit
    - BouncyCastle.Cryptography (transitive) → fixed by upgrading MailKit
    - Microsoft.Extensions.Caching.Memory 8.0.0 → 9.0.5
        GHSA-qj66-m88j-hmgj (High) – fixed in 8.0.1 / 9.0.0
    - System.Text.Json 8.0.0 → 8.0.5
        GHSA-hh2w-p6rv-4g7w (High) – fixed in 8.0.5
        GHSA-8g4q-xg66-9fp4 (High) – fixed in 8.0.5
    - System.Formats.Asn1 7.0.0 (transitive) → forced to 8.0.1
        GHSA-447r-wph3-92pm (High)  – fixed in 8.0.1
  -->

  <ItemGroup>
    <!-- Auth & Security -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.15" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt"               Version="8.6.1"  />
    <PackageReference Include="BCrypt.Net-Next"                                Version="4.0.3"  />

    <!-- Database -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite"           Version="8.0.15" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design"           Version="8.0.15" />

    <!-- Rate Limiting -->
    <PackageReference Include="AspNetCoreRateLimit"                            Version="5.0.0"  />

    <!-- Logging -->
    <PackageReference Include="Serilog.AspNetCore"                             Version="8.0.3"  />
    <PackageReference Include="Serilog.Sinks.Console"                          Version="6.0.0"  />
    <PackageReference Include="Serilog.Sinks.File"                             Version="6.0.0"  />
    <PackageReference Include="Serilog.Formatting.Compact"                     Version="3.0.0"  />

    <!-- Health Checks -->
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" Version="8.0.15" />

    <!-- Email — patched: MailKit 4.8+ fixes GHSA-9j88-vvj5-vhgr -->
    <PackageReference Include="MailKit"                                         Version="4.9.0"  />

    <!-- Image Upload — patched: 3.1.5+ fixes High CVEs -->
    <PackageReference Include="SixLabors.ImageSharp"                           Version="3.1.7"  />

    <!-- Swagger -->
    <PackageReference Include="Swashbuckle.AspNetCore"                         Version="6.9.0"  />

    <!--
      Force transitive dependencies to safe versions.
      These are pulled in by other packages; pinning them here
      ensures the vulnerability scanner sees the patched versions.
    -->
    <PackageReference Include="System.Text.Json"       Version="8.0.5"  />
    <PackageReference Include="System.Formats.Asn1"    Version="8.0.1"  />
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" Version="9.0.5" />
  </ItemGroup>

</Project>

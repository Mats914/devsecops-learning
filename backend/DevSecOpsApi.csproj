<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>DevSecOpsApi</RootNamespace>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Tests\**" />
    <Content Remove="Tests\**" />
    <EmbeddedResource Remove="Tests\**" />
    <None Remove="Tests\**" />
  </ItemGroup>

  <ItemGroup>
    <!-- Autentisering och säkerhet -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.15" />
    <PackageReference Include="Microsoft.Bcl.Memory" Version="10.0.9" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.6.1" />
    <PackageReference Include="BCrypt.Net-Next" Version="4.0.3" />
    <!--
      Överskriver transitiv SQLite-bibliotek:
      EF Core Sqlite drar in SQLitePCLRaw 2.x (SQLite < 3.50.2).
      Pin 3.50.3 fixar GHSA-2m69-gcr7-jv3q tills upstream uppdaterar.
    -->
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="3.50.3" />

    <!-- Databas -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="8.0.15" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.15" />

    <!-- Begränsar antal försök mot auth-endpoints -->
    <PackageReference Include="AspNetCoreRateLimit" Version="5.0.0" />

    <!-- Strukturerad loggning -->
    <PackageReference Include="Serilog.AspNetCore" Version="8.0.3" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
    <PackageReference Include="Serilog.Formatting.Compact" Version="3.0.0" />

    <!-- Hälsokontroll för CI/CD smoke test -->
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" Version="8.0.15" />

    <!-- E-post (MailKit) – avstängt som standard i dev -->
    <PackageReference Include="MailKit" Version="4.17.0" />

    <!-- Bildbehandling – 3.x är gratis, 4.x kräver licens -->
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" />

    <!-- API-dokumentation i utvecklingsläge -->
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.9.0" />

    <!--
      Tvinga transitiva beroenden till patchade versioner.
      dotnet väljer lägsta kompatibla version som standard.
    -->

    <!-- System.Text.Json 8.0.5 – fixar två High-sårbarheter -->
    <PackageReference Include="System.Text.Json" Version="8.0.5" />

    <!-- System.Formats.Asn1 8.0.1 – fixar High-sårbarhet -->
    <PackageReference Include="System.Formats.Asn1" Version="8.0.1" />

    <!-- Caching.Memory 9.x fungerar med .NET 8 och fixar High-sårbarhet -->
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" Version="9.0.5" />
  </ItemGroup>

</Project>

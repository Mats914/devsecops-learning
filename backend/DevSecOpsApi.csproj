<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>DevSecOpsApi</RootNamespace>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Tests\**" />
    <Content Remove="Tests\**" />
    <EmbeddedResource Remove="Tests\**" />
    <None Remove="Tests\**" />
  </ItemGroup>

  <ItemGroup>
    <!-- Auth & Security -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.15" />
    <PackageReference Include="Microsoft.Bcl.Memory" Version="10.0.9" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.6.1" />
    <PackageReference Include="BCrypt.Net-Next" Version="4.0.3" />
    <!--
      SQLite native lib override:
      EF Core Sqlite pulls SQLitePCLRaw.lib.e_sqlite3 2.x transitively (SQLite < 3.50.2).
      Pin 3.50.3 to fix GHSA-2m69-gcr7-jv3q / CVE-2025-6965 until upstream updates.
    -->
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="3.50.3" />

    <!-- Database -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="8.0.15" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.15" />

    <!-- Rate Limiting -->
    <PackageReference Include="AspNetCoreRateLimit" Version="5.0.0" />

    <!-- Logging -->
    <PackageReference Include="Serilog.AspNetCore" Version="8.0.3" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
    <PackageReference Include="Serilog.Formatting.Compact" Version="3.0.0" />

    <!-- Health Checks -->
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" Version="8.0.15" />

    <!--
      EMAIL: MailKit 4.17.0 — current patched release
    -->
    <PackageReference Include="MailKit" Version="4.17.0" />

    <!-- IMAGE: SixLabors.ImageSharp 3.1.12 (free OSS line; 4.x requires paid license) -->
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" />

    <!-- Swagger -->
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.9.0" />

    <!--
      FORCE transitive deps to patched versions.
      dotnet resolves the LOWEST compatible version by default,
      so we must explicitly pin these to override vulnerable versions.
    -->

    <!-- System.Text.Json 8.0.5 fixes GHSA-hh2w-p6rv-4g7w + GHSA-8g4q-xg66-9fp4 (both High) -->
    <PackageReference Include="System.Text.Json" Version="8.0.5" />

    <!-- System.Formats.Asn1 8.0.1 fixes GHSA-447r-wph3-92pm (High) -->
    <PackageReference Include="System.Formats.Asn1" Version="8.0.1" />

    <!--
      Microsoft.Extensions.Caching.Memory 9.0.5 fixes GHSA-qj66-m88j-hmgj (High)
      Note: 9.x is compatible with .NET 8 apps
    -->
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" Version="9.0.5" />
  </ItemGroup>

</Project>
